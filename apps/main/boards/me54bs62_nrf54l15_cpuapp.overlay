/*
 * apps/main - chinh devicetree rieng cho app (board giu nguyen).
 *
 * PDM20: hang doi khoi da thu tu 4 (mac dinh) len 10 = 100 ms. Driver dung han PDM khi hang
 * day, nen hang lon cho phep thread giong noi cham thoang qua ma micro khong bi dung.
 * Khong vuot qua MIC_BLOCK_COUNT (12, mic_in.c) tru 2 khoi DMA dang giu.
 */
&pdm20 {
	queue-size = <10>;
};
